# Développement — les appels API passent par le proxy Vite (vite.config.js) :
# le navigateur reste en même origine, donc plus aucun blocage CORS, même quand
# le site est partagé sur le réseau local (http://IP:port).
# (Les builds de production utilisent l'URL réelle par défaut dans src/services/api.js.)
VITE_API_URL=/api
